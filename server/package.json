{
  "name": "sixiang-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "四象 Sixiang - 个人效率工作台后端 API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
